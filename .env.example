# Supabase Credentials (for loading data and exporting results)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LLM Credentials (for cluster naming)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# UMAP Hyperparameters (optional overrides)
UMAP_N_NEIGHBORS=15
UMAP_N_COMPONENTS=15
UMAP_MIN_DIST=0.0
UMAP_METRIC=cosine
UMAP_RANDOM_STATE=42

# HDBSCAN Hyperparameters (optional overrides)
HDBSCAN_MIN_CLUSTER_SIZE=15
HDBSCAN_MIN_SAMPLES=5
HDBSCAN_METRIC=euclidean

# Post-Clustering Quality Filters & IDF Weighting (optional overrides)
MIN_SKILLS_PER_CLUSTER=3
MIN_OFFERS_PER_CLUSTER=15
COSINE_DEDUP_THRESHOLD=0.93
TRANSVERSAL_PENALTY_THRESHOLD=0.35
TRANSVERSAL_PENALTY_FACTOR=0.2
